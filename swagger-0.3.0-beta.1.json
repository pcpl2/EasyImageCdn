{
  "openapi": "3.0.3",
  "info": {
    "title": "EasyImageCdn 0.3.0-beta.1",
    "description": "This is a api specification of EasyImageCdn",
    "license": {
      "name": "BSD-2-Clause license",
      "url": "https://github.com/pcpl2/EasyImageCdn/blob/main/LICENSE"
    },
    "version": "0.3.0-beta.1"
  },
  "tags": [
    {
      "name": "Admin",
      "description": "Admin endpoints"
    },
    {
      "name": "Public",
      "description": "Public endpoints"
    }
  ],
  "paths": {
    "/v1/newImage": {
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "Send new image as json payload",
        "description": "Send new image as json payload",
        "operationId": "newImagePlayload",
        "requestBody": {
          "description": "Send new image as json payload",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImagePayload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Uploaded Image",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImageUploadedResponse"
                }
              }
            }
          },
          "204": {
            "description": "Cannot read file from payload"
          },
          "400": {
            "description": "Other error in parsing id/content or invalid content type"
          },
          "401": {
            "description": "Invalid api key"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/v1/newImageMp": {
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "Send new image as multipart",
        "description": "",
        "operationId": "uploadFile",
        "parameters": [
          {
            "name": "imageId",
            "in": "query",
            "description": "Image id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "imageFile": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Uploaded Image",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImageUploadedResponse"
                }
              }
            }
          },
          "400": {
            "description": "Other error in parsing id/content or invalid content type"
          },
          "401": {
            "description": "Invalid api key"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/v1/job/{job_id}/status": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "Get job status",
        "description": "",
        "operationId": "getJobStatusRest",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "description": "Job id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Job status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobStatusResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid api key"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/v1/job/{job_id}/ws": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "Get job status with websocket",
        "description": "",
        "operationId": "getJobStatusWebscoket",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "description": "Job id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Job status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobStatusResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid api key"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/v1/job/{job_id}/sse": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "Get Job status with Server Sent Events",
        "description": "",
        "operationId": "getJobStatussse",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "description": "Job id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Job status",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/JobStatusResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid api key"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/{imageId}": {
      "get": {
        "tags": [
          "Public"
        ],
        "summary": "Get orginal size image",
        "description": "",
        "operationId": "getImageOrginalSize",
        "parameters": [
          {
            "name": "imageId",
            "in": "path",
            "description": "Image id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "refresh",
            "in": "query",
            "description": "Disable cache for this download",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "in": "header",
            "name": "Accept",
            "schema": {
              "type": "string"
            },
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Return image",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/webp": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "Image not found"
          }
        }
      }
    },
    "/{imageId}/{resolution}": {
      "get": {
        "tags": [
          "Public"
        ],
        "summary": "Get resized image",
        "description": "",
        "operationId": "getImageResized",
        "parameters": [
          {
            "name": "imageId",
            "in": "path",
            "description": "Image id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "resolution",
            "in": "path",
            "description": "Image resolution ex. 1024x720",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "refresh",
            "in": "query",
            "description": "Disable cache for this download",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "in": "header",
            "name": "Accept",
            "schema": {
              "type": "string"
            },
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Return image",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/webp": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "Image not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ImageUploadedResponse": {
        "type": "object",
        "properties": {
          "job_id": {
            "type": "string",
            "format": "uuid",
            "example": "81a620f3-193a-4661-b5b4-a4810a3153a5"
          },
          "image_id": {
            "type": "string",
            "example": "aabb123"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          }
        }
      },
      "JobStatusResponse": {
        "type": "object",
        "properties": {
          "Status": {
            "$ref": "#/components/schemas/JobStatus"
          }
        }
      },
      "JobStatus": {
        "type": "string",
        "example": "Queued",
        "enum": [
          "Queued",
          "Processing",
          "Completed",
          "Failed"
        ]
      },
      "ImagePayload": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "aabb123"
          },
          "image": {
            "type": "string",
            "format": "base64",
            "example": "aabb="
          }
        }
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "key"
      }
    }
  }
}